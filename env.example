# Get a free key at https://build.nvidia.com (click any model -> Get API
# Key). No credit card required. This stays on your server — Janitor AI
# never sees it.
NVIDIA_API_KEY=your_nvidia_nim_key_here

# Optional, defaults to 3000 (only used for local dev, ignored on Vercel)
PORT=3000

# Optional. Comma-separated alias names tried in order when a model answers
# 404/410 (retired / unavailable). Default:
# glm-5.3-thinking,nemotron-omni-30b-thinking,deepseek-v4.1-flash-thinking,glm-5.3-flash-thinking
# NIM_FALLBACK_MODELS=glm-5.3-thinking,nemotron-omni-30b-thinking

# Optional time limits (milliseconds) for NVIDIA to START answering before the
# proxy tries the next model. Defaults shown.
# NIM_FIRST_RESPONSE_MS=20000
# NIM_NONSTREAM_RESPONSE_MS=60000
# NIM_TOTAL_BUDGET_MS=90000

# Optional. The proxy remembers models that just failed (retired, not
# answering, busy) and skips them for a while. Set to "off" to disable.
# NIM_MODEL_MEMORY=off
